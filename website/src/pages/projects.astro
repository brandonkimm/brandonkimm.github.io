
---
import '../styles/global.css';
import '../styles/portfolio.css';

const projects = [
  {
    title: 'DDoS Detection Pipeline',
    description:
      'A machine learning pipeline for classifying network traffic and investigating DDoS attack patterns.',
    technologies: 'Python, scikit-learn, pandas',
  },
  {
    title: 'LLM Security Research',
    description:
      'Research explorations involving language models, online learning, and data poisoning.',
    technologies: 'Python, Machine Learning, LLMs',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Projects | Your Name</title>
  </head>
  <body>
    <main class="content-page">
      <a href="/">← Home</a>
      <h1>Projects</h1>
      <p>
        A selection of my programming projects,
        technical experiments, and research work.
      </p>

      {projects.map((project) => (
        <article>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <small>{project.technologies}</small>
        </article>
      ))}
    </main>
  </body>
</html>

<style>
  article {
    border-bottom: 1px solid #e5e7eb;
    padding: 20px 0;
  }

  small {
    color: #64748b;
  }
</style>
