
---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Writing | Brandon Kim"
  description="Research paper reviews, technical explorations, computer science notes, and book reviews by Brandon Kim."
>
  <div class="writing-page">
    <!-- Page Introduction -->
    <section class="page-intro">
      <p class="eyebrow">THOUGHTS & EXPLORATIONS</p>

      <h1>Writing<span class="accent">.</span></h1>

      <p class="intro">
        A collection of research paper reviews, technical
        explorations, book notes, and things I've learned
        along the way.
      </p>
    </section>

    <!-- Article List -->
    <section class="articles-section">
      <div class="section-heading">
        <h2>All Articles</h2>

        <span class="article-count">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'}
        </span>
      </div>

      {posts.length > 0 ? (
        <div class="article-list">
          {posts.map((post) => (
            <article class="article">
              <a href={`/blog/${post.id}/`} class="article-link">
                <div class="article-content">
                  <p class="article-date">
                    <FormattedDate date={post.data.pubDate} />
                  </p>

                  <h3>{post.data.title}</h3>

                  {post.data.description && (
                    <p class="article-description">
                      {post.data.description}
                    </p>
                  )}

                  <span class="read-more">
                    Read article →
                  </span>
                </div>

                {post.data.heroImage && (
                  <div class="article-image">
                    <Image
                      src={post.data.heroImage}
                      width={320}
                      height={180}
                      alt={`Cover image for ${post.data.title}`}
                    />
                  </div>
                )}
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3>Articles coming soon.</h3>
          <p>
            I'm currently working on research paper reviews,
            technical notes, and other writing.
          </p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .writing-page {
    max-width: 900px;
    padding: 95px 0 130px;
  }

  .page-intro {
    margin-bottom: 110px;
  }

  .eyebrow {
    color: #64748b;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    font-weight: 650;
    text-transform: uppercase;
  }

  .accent {
    color: #2563eb;
  }

  h1 {
    font-size: clamp(2.8rem, 5vw, 3.7rem);
    letter-spacing: -0.055em;
    line-height: 1.2;
    margin: 22px 0 34px;
  }

  .intro {
    color: #68717d;
    font-size: 1.1rem;
    line-height: 1.85;
    max-width: 670px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-bottom: 28px;
    border-bottom: 1px solid #e8e8e5;
  }

  h2 {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .article-count {
    color: #94a3b8;
    font-size: 0.85rem;
  }

  .article {
    border-bottom: 1px solid #e8e8e5;
  }

  .article-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 38px;
    text-decoration: none;
    padding: 42px 0;
  }

  .article-content {
    flex: 1;
    min-width: 0;
  }

  .article-date {
    color: #94a3b8;
    font-size: 0.82rem;
    margin: 0 0 12px;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
    transition: color 0.2s;
  }

  .article-description {
    color: #68717d;
    font-size: 0.93rem;
    line-height: 1.8;
    margin: 0 0 23px;
  }

  .read-more {
    color: #2563eb;
    font-size: 0.85rem;
    font-weight: 550;
  }

  .article-link:hover h3 {
    color: #2563eb;
  }

  .article-image {
    width: 200px;
    flex-shrink: 0;
  }

  .article-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
  }

  .empty-state {
    padding: 55px 0;
  }

  .empty-state h3 {
    margin-bottom: 8px;
  }

  .empty-state p {
    color: #68717d;
  }

  @media (max-width: 700px) {
    .writing-page {
      padding: 65px 0 90px;
    }

    .page-intro {
      margin-bottom: 65px;
    }

    .article-link {
      align-items: flex-start;
      flex-direction: column-reverse;
      gap: 18px;
    }

    .article-image {
      width: 100%;
    }

    .article-image img {
      max-height: 230px;
    }

    .section-heading {
      align-items: flex-start;
    }
  }
</style>
