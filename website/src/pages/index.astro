
---
import BaseLayout from '../layouts/BaseLayout.astro';

const name = 'Brandon Kim';
const github = 'https://github.com/brandonkimm';

const projects = [
  {
    title: 'DDoS Detection Pipeline',
    category: 'Machine Learning · Security',
    description:
      'Exploring network intrusion detection using classical machine learning models and traffic data.',
  },
  {
    title: 'LLM Security Research',
    category: 'AI · Research',
    description:
      'Investigating data poisoning, online learning, and security challenges in language models.',
  },
];

const interests = [
  'Machine Learning',
  'Computer Systems',
  'AI Security',
  'Applied Mathematics',
];
---

<BaseLayout
  title="Brandon Kim | Computer Science & Research"
  description="Brandon Kim — Applied Mathematics–Computer Science student at Brown University. Projects, research, and technical writing."
>
  <!-- Hero Section -->
  <section class="hero">
    <p class="eyebrow">
      BROWN UNIVERSITY · APPLIED MATHEMATICS–CS
    </p>

    <h1>Hi, I'm {name}<span class="accent">.</span></h1>

    <p class="intro">
      I'm an Applied Mathematics–Computer Science student
      at Brown University interested in machine learning,
      computer systems, and security.
    </p>

    <p class="intro-secondary">
      I enjoy building software, understanding research,
      and exploring how complex systems work.
      This is where I share my projects, technical writing,
      and things I'm learning.
    </p>

    <div class="links">
      <a class="primary" href="/projects">
        Explore my work →
      </a>

      <a
        class="secondary"
        href={github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub ↗
      </a>
    </div>
  </section>

  <!-- Interests Section -->
  <section class="interests-section">
    <p class="eyebrow">AREAS OF INTEREST</p>

    <div class="interests">
      {interests.map((interest) => (
        <span class="interest-tag">{interest}</span>
      ))}
    </div>
  </section>

  <!-- Projects Section -->
  <section class="projects-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">WHAT I'VE WORKED ON</p>
        <h2>Featured Projects</h2>
      </div>

      <a href="/projects" class="view-all">
        All projects ↗
      </a>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <article class="project">
          <p class="project-category">
            {project.category}
          </p>

          <h3>{project.title}</h3>

          <p class="project-description">
            {project.description}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Writing Section -->
  <section class="writing-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THOUGHTS & EXPLORATIONS</p>
        <h2>Writing & Notes</h2>
      </div>

      <a href="/blog" class="view-all">
        All writing ↗
      </a>
    </div>

    <div class="writing-content">
      <div class="writing-icon" aria-hidden="true">✳</div>

      <div>
        <h3>Learning in public.</h3>

        <p>
          I write about research papers, computer science
          concepts, books, and technical experiments.
          These notes help me explore ideas more deeply
          and share what I learn.
        </p>

        <a href="/blog" class="view-all">
          Explore my writing →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 85px 0 95px;
    max-width: 790px;
  }

  .eyebrow {
    color: #64748b;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    font-weight: 650;
  }

  .accent {
    color: #2563eb;
  }

  h1 {
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    letter-spacing: -0.06em;
    line-height: 1.15;
    margin: 18px 0 25px;
  }

  h2 {
    font-size: 1.9rem;
    letter-spacing: -0.04em;
    margin: 8px 0 0;
    line-height: 1.25;
  }

  h3 {
    font-size: 1.2rem;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }

  .intro {
    color: #242831;
    max-width: 700px;
    font-size: 1.2rem;
    line-height: 1.8;
  }

  .intro-secondary {
    color: #68717d;
    max-width: 660px;
    font-size: 1rem;
    line-height: 1.85;
    margin-top: 16px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .links a {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .primary {
    display: inline-block;
    background: #252b36;
    color: white;
    padding: 12px 20px;
    border-radius: 7px;
    transition: background 0.2s;
  }

  .primary:hover {
    background: #2563eb;
  }

  .secondary {
    color: #475569;
  }

  .secondary:hover {
    color: #2563eb;
  }

  .interests-section {
    padding: 30px 0 75px;
    border-top: 1px solid #e8e8e5;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .interest-tag {
    padding: 7px 13px;
    background: #f0f0ed;
    color: #58616c;
    border-radius: 5px;
    font-size: 0.8rem;
  }

  .projects-section,
  .writing-section {
    margin-bottom: 100px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 28px;
  }

  .view-all {
    color: #2563eb;
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 550;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .project {
    background: white;
    border: 1px solid #e4e6e8;
    border-radius: 10px;
    padding: 28px;
    transition: border-color 0.2s;
  }

  .project:hover {
    border-color: #a6b7ce;
  }

  .project-category {
    color: #708198;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 650;
    margin: 0 0 30px;
  }

  .project-description {
    color: #66717e;
    font-size: 0.92rem;
    line-height: 1.8;
    margin: 0;
  }

  .writing-content {
    border-top: 1px solid #e4e6e8;
    padding-top: 32px;
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .writing-icon {
    color: #2563eb;
    font-size: 1.8rem;
    line-height: 1.3;
  }

  .writing-content p {
    color: #68717d;
    font-size: 0.95rem;
    line-height: 1.85;
    max-width: 650px;
    margin: 0 0 18px;
  }

  @media (max-width: 700px) {
    .hero {
      padding: 70px 0 75px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .projects-section,
    .writing-section {
      margin-bottom: 75px;
    }
  }
</style>
