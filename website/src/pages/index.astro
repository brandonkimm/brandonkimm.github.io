---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  { number: '01', name: 'About', description: 'Background & interests', href: '/about' },
  { number: '02', name: 'Projects', description: 'Software & research', href: '/projects' },
  { number: '03', name: 'Writing', description: 'Technical notes & ideas', href: '/blog' },
];
---

<BaseLayout
  title="Brandon Kim | Computer Science & Research"
  description="Brandon Kim — Applied Mathematics–Computer Science student at Brown University. Software, research, and technical writing."
  minimalHeader
>
  <div class="home-index">
    <section class="intro" aria-labelledby="home-title">
      <h1 id="home-title">Brandon Kim<span class="period">.</span></h1>
      <p class="tagline">Computer science student at Brown University, interested in machine learning, systems, and security.</p>
    </section>

    <nav class="index-links" aria-label="Explore the website">
      {sections.map((section) => (
        <a class="index-link" href={section.href}>
          <span class="number">{section.number}</span>
          <span class="link-copy">
            <span class="link-title">{section.name}</span>
            <span class="link-description">{section.description}</span>
          </span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </div>
</BaseLayout>

<style>
  .home-index {
    max-width: 820px;
    margin: 0 auto;
  }

  .intro {
    padding: clamp(94px, 13vw, 165px) 0 clamp(92px, 12vw, 140px);
  }

  h1, .link-title {
    font-family: var(--font-display);
    font-weight: 400;
  }

  h1 {
    margin: 0 0 24px;
    font-size: clamp(3.8rem, 9vw, 6.2rem);
    line-height: 1.06;
    letter-spacing: -0.046em;
    color: #242831;
  }

  .period { color: #2563eb; }

  .tagline {
    max-width: 590px;
    margin: 0;
    color: #68717d;
    font-size: clamp(1rem, 2vw, 1.11rem);
    line-height: 1.85;
  }

  .index-links {
    border-top: 1px solid #dcdedc;
    margin-bottom: clamp(110px, 15vw, 180px);
  }

  .index-link {
    display: grid;
    grid-template-columns: 42px 1fr 30px;
    gap: 22px;
    align-items: center;
    padding: 33px 8px 34px 0;
    border-bottom: 1px solid #dcdedc;
    color: inherit;
    text-decoration: none;
    transition: padding-left 180ms ease, color 180ms ease;
  }

  .index-link:hover, .index-link:focus-visible {
    padding-left: 8px;
    color: #2563eb;
  }

  .index-link:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 4px;
  }

  .number {
    align-self: start;
    padding-top: 9px;
    color: #92969b;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .link-copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .link-title {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .link-description {
    color: #858a90;
    font-size: 0.86rem;
  }

  .arrow {
    align-self: center;
    justify-self: end;
    color: #89919b;
    font-size: 1.4rem;
  }

  @media (max-width: 600px) {
    .intro { padding: 80px 0 92px; }
    .index-link { grid-template-columns: 25px 1fr 24px; gap: 12px; padding: 26px 0; }
    .number { padding-top: 6px; }
    .index-links { margin-bottom: 90px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-link { transition: none; }
  }
</style>
