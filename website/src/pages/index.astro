
---
const name = 'Brandon Kim';
const github = 'https://github.com/brandonkimm';

const projects = [
  {
    title: 'DDoS Detection Pipeline',
    category: 'Machine Learning · Security',
    description:
      'Exploring network intrusion detection using classical machine learning models and traffic data.',
  },
  {
    title: 'LLM Security Research',
    category: 'AI · Research',
    description:
      'Investigating data poisoning, online learning, and security challenges in language models.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Personal website, technical projects, and research writing."
    />
    <title>{name} | Computer Science</title>
  </head>

  <body>
    <div class="container">
      <header>
        <a class="brand" href="/">{name}</a>
        <nav aria-label="Main navigation">
          <a href="/about">About</a>
          <a href="/projects">Projects</a>
          <a href="/blog">Writing</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <p class="eyebrow">
            APPLIED MATHEMATICS · COMPUTER SCIENCE
          </p>
          <h1>Hi, I'm {name}.</h1>
          <p class="intro">
            I'm a student at Brown University interested in
            machine learning, computer systems, and security.
            I enjoy building software, understanding research,
            and exploring how complex systems work.
          </p>
          <div class="links">
            <a class="primary" href="/projects">View projects →</a>
            <a href={github} target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
          </div>
        </section>

        <section>
          <div class="section-heading">
            <h2>Selected Projects</h2>
            <a href="/projects">All projects →</a>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class="project">
                <p class="eyebrow">{project.category}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="writing">
          <div class="section-heading">
            <h2>Writing</h2>
            <a href="/blog">All articles →</a>
          </div>
          <p>
            Notes and reflections on research papers,
            computer science, mathematics, and books.
          </p>
          <a href="/blog">Explore my writing →</a>
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} {name}</span>
        <a href={github}>GitHub</a>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fafaf9;
    color: #1c242b;
    font-family: Inter, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    max-width: 1000px;
    margin: auto;
    padding: 0 28px;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30px 0;
    border-bottom: 1px solid #e5e7eb;
    gap: 20px;
  }

  .brand {
    font-size: 1.2rem;
    font-weight: 750;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  nav a {
    color: #475569;
    text-decoration: none;
  }

  nav a:hover,
  .section-heading a:hover {
    color: #2563eb;
  }

  .hero {
    padding: 110px 0 100px;
  }

  .eyebrow {
    color: #64748b;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    font-weight: 650;
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.3rem);
    letter-spacing: -0.055em;
    line-height: 1.15;
    margin: 20px 0;
  }

  h2 {
    font-size: 1.55rem;
    letter-spacing: -0.03em;
  }

  .intro {
    color: #475569;
    max-width: 660px;
    font-size: 1.15rem;
    line-height: 1.85;
  }

  .links {
    display: flex;
    gap: 24px;
    align-items: center;
    margin-top: 32px;
  }

  .links a {
    text-decoration: none;
    font-weight: 600;
  }

  .primary {
    background: #1e293b;
    color: white;
    padding: 11px 19px;
    border-radius: 7px;
  }

  section {
    margin-bottom: 95px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
  }

  .section-heading a,
  .writing > a {
    color: #2563eb;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .project {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 28px;
  }

  .project h3 {
    margin: 8px 0;
  }

  .project > p:last-child,
  .writing > p {
    color: #64748b;
  }

  footer {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #e5e7eb;
    padding: 30px 0;
    color: #64748b;
    font-size: 0.85rem;
  }

  @media (max-width: 650px) {
    header {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero {
      padding: 75px 0;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
