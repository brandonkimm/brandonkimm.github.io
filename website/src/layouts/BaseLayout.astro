---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  minimalHeader?: boolean;
}

const {
  title,
  description = 'Personal website of Brandon Kim — computer science, research, projects, and writing.',
  minimalHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>

  <body>
    <div class="site-container">
      <Header minimal={minimalHeader} />

      <main id="main-content">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
