
---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Personal website of Brandon Kim — computer science, research, projects, and writing.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <div class="site-container">
      <Header />

      <main id="main-content">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
