---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={`${title} | Brandon Kim`} description={description}>
  <article class="blog-post">
    <header class="post-header">
      <a class="back-link" href="/blog">← All writing</a>
      <p class="eyebrow">WRITING & NOTES</p>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-date">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <span class="updated-date">
            · Updated <FormattedDate date={updatedDate} />
          </span>
        )}
      </div>
    </header>

    {heroImage && (
      <div class="hero-image">
        <Image
          width={1020}
          height={510}
          src={heroImage}
          alt={`Cover image for ${title}`}
        />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a href="/blog">← Back to all writing</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding: 75px 0 105px;
  }

  .post-header {
    max-width: 760px;
    margin: 0 auto 46px;
  }

  .back-link,
  .post-footer a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover,
  .post-footer a:hover {
    text-decoration: underline;
  }

  .eyebrow {
    color: #64748b;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    margin: 44px 0 14px;
  }

  h1 {
    color: var(--text);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.05em;
    line-height: 1.2;
    margin: 0 0 20px;
  }

  .post-description {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.8;
    margin: 0 0 22px;
  }

  .post-date {
    color: #84909e;
    font-size: 0.85rem;
  }

  .hero-image {
    max-width: 900px;
    margin: 0 auto 48px;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 9px;
  }

  .prose {
    max-width: 760px;
    margin: 0 auto;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  /* Rendered Markdown children need global selectors in Astro scoped CSS. */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--text);
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .prose :global(h2) {
    font-size: 1.8rem;
    margin: 2.5em 0 0.8em;
  }

  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 2em 0 0.7em;
  }

  .prose :global(h4) {
    font-size: 1.1rem;
    margin: 1.8em 0 0.6em;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin: 0 0 1.45em;
  }

  .prose :global(li) {
    margin-bottom: 0.45em;
  }

  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: 20px;
    color: var(--muted);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .prose :global(pre) {
    max-width: 100%;
    padding: 20px;
    overflow-x: auto;
    border-radius: 8px;
    line-height: 1.6;
  }

  .prose :global(:not(pre) > code) {
    background: #eceef1;
    border-radius: 4px;
    padding: 0.15em 0.35em;
    font-size: 0.88em;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 2em 0;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }

  .post-footer {
    max-width: 760px;
    margin: 75px auto 0;
    padding-top: 26px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 700px) {
    .blog-post {
      padding: 52px 0 75px;
    }

    .eyebrow {
      margin-top: 32px;
    }

    .post-header {
      margin-bottom: 34px;
    }

    .hero-image {
      margin-bottom: 34px;
    }

    .post-description {
      font-size: 1rem;
    }
  }
</style>
