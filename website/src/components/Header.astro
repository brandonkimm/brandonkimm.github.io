
---
const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Writing', href: '/blog' },
];

const github = 'https://github.com/brandonkimm';
---

<header class="navbar">
  <a href="/" class="logo">
    Brandon Kim<span class="dot">.</span>
  </a>

  <nav aria-label="Main navigation">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}

    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub ↗
    </a>
  </nav>
</header>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 30px 0;
    border-bottom: 1px solid #e8e8e5;
    gap: 20px;
  }

  .logo {
    font-size: 1.15rem;
    font-weight: 750;
    text-decoration: none;
    letter-spacing: -0.035em;
  }

  .dot {
    color: #2563eb;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  nav a {
    text-decoration: none;
    color: #59616e;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  nav a:hover {
    color: #2563eb;
  }

  @media (max-width: 700px) {
    .navbar {
      flex-direction: column;
      align-items: flex-start;
      padding: 22px 0;
    }

    nav {
      flex-wrap: wrap;
      gap: 13px 20px;
    }

    nav a {
      font-size: 0.85rem;
    }
  }
</style>
