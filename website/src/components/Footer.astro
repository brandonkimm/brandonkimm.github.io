
---
const year = new Date().getFullYear();
---

<footer class="footer">
  <span>© {year} Brandon Kim</span>

  <div class="footer-links">
    <a
      href="https://github.com/brandonkimm"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
    </a>
    <a href="/blog">Writing</a>
    <a href="/about">About</a>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid #e8e8e5;
    padding: 30px 0 45px;
    color: #84909e;
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    gap: 23px;
  }

  .footer-links a {
    text-decoration: none;
    color: #59616e;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #2563eb;
  }

  @media (max-width: 700px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
